rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// Security model:
//  - Rooms can't be listed. You can only reach a room if you know its ID,
//    and the ID is derived from the secret pairing code (PBKDF2), so it
//    can't be guessed.
//  - Messages are end-to-end encrypted (AES-GCM, key from the pairing code),
//    so Firestore only ever stores ciphertext.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/messages/{msg} {
      allow read, delete: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['p', 'at', 'expireAt'])
        && request.resource.data.p is string
        && request.resource.data.p.size() < 30000
        && request.resource.data.at == request.time;

      allow update: if false;
    }
  }
}
