rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId}/messages/{messageId} {
      // Pairing codes are generated randomly (16+ characters) and never
      // uploaded. The room ID is their SHA-256 digest. Only ciphertext is stored.
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nonce', 'ciphertext', 'sender', 'createdAt'])
        && request.resource.data.nonce is string
        && request.resource.data.ciphertext is string
        && request.resource.data.sender is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
