rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // The room ID is a SHA-256 digest of a randomly generated 16+ character
      // pairing secret. The secret itself is never uploaded to Firestore.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'receiverUid', 'receiverName', 'receiverModel',
          'receiverConnectedAt', 'status', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.receiverUid == null
        && request.resource.data.status == 'WAITING';

      // Exactly one receiver can claim a room. Firestore serializes concurrent
      // transaction attempts; after the first claim, receiverUid is no longer null.
      allow update: if request.auth != null && (
        (
          resource.data.receiverUid == null
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.receiverUid == request.auth.uid
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.status == 'CONNECTED'
          && request.resource.data.receiverName is string
          && request.resource.data.receiverName.size() > 0
          && request.resource.data.receiverName.size() <= 50
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'receiverUid', 'receiverName', 'receiverModel', 'receiverConnectedAt', 'status'
          ])
        )
        ||
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.receiverUid != null
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.receiverUid == null
          && request.resource.data.status == 'WAITING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'receiverUid', 'receiverName', 'receiverModel', 'receiverConnectedAt', 'status'
          ])
        )
      );

      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        allow read, delete: if request.auth != null
          && (room().ownerUid == request.auth.uid || room().receiverUid == request.auth.uid);

        allow create: if request.auth != null
          && room().ownerUid == request.auth.uid
          && room().receiverUid != null
          && request.resource.data.keys().hasOnly(['nonce', 'ciphertext', 'sender', 'createdAt'])
          && request.resource.data.nonce is string
          && request.resource.data.ciphertext is string
          && request.resource.data.sender is string
          && request.resource.data.createdAt == request.time;

        allow update: if false;
      }
    }
  }
}
